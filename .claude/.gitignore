# Machine-specific Claude Code overrides.
settings.local.json

# Local names guard-repo-content.ts keeps out of tracked files (one regex per line).
hooks/private-patterns.local

# Git worktrees Claude Code checks out under .claude/. Tools that discover nested
# configs (biome, eslint) may also need `.claude/worktrees/` in the root .gitignore.
worktrees/
