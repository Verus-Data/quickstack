{
  "permissions": {
    "allow": [
      "Bash(bun run test:tui)",
      "Bash(bun test ./tests/tui)",
      "Bash(bun test ./tests/tui/*)",
      "Bash(bun run stub)",
      "Bash(bun run stub:stop)",
      "Bash(bun run tui:capture *)",
      "Bash(bun run eval -- --dry-run)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/chat-cli-status.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-chat-cli-commands.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-chat-cli-generated.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-chat-boundaries.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
