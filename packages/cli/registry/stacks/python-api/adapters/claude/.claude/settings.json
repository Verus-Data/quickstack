{
  "permissions": {
    "allow": [
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make coverage)",
      "Bash(make openapi)",
      "Bash(make check-openapi)",
      "Bash(uv run pytest *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-openapi.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
