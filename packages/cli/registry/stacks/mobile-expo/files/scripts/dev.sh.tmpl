#!/usr/bin/env bash
# Record the whole dev stack, preserving colours and Metro's terminal keys on
# macOS. Process ownership and cleanup live in scripts/dev.ts.
set -euo pipefail
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$0")/.."

LOG_FILE=".logs/dev.log"
if [[ -z "${{{env_prefix}}_DEV_LOG:-}" ]]; then
  mkdir -p "$(dirname "$LOG_FILE")"
  export {{env_prefix}}_DEV_LOG=1
  if [[ "$(uname)" == "Darwin" && -t 0 && -t 1 ]] && command -v script >/dev/null 2>&1; then
    exec script -qeF "$LOG_FILE" "$SELF" "$@"
  fi
  exec > >(tee "$LOG_FILE") 2>&1
fi

exec bun scripts/dev.ts "$@"
