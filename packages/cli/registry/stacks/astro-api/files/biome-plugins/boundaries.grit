// Workspace platform, schema, environment, and logging boundaries.
language js

or {
  or {
    JsModuleSource() as $src,
    `import($src)`
  } where {
    $filename <: r".*/(?:apps/(?:api|web)|packages/contract)/src/.*",
    or {
      and {
        $src <: r"[\"'](?:node:[^\"']+|bun|bun:[^\"']*|@effect/platform-(?:node|bun)[^\"']*)[\"']",
        $filename <: not r".*/apps/api/src/platform/.*",
        register_diagnostic(span=$src, message="Runtime imports belong in apps/api/src/platform/; use Effect's FileSystem, Path and HttpClient services elsewhere.")
      },
      and {
        $src <: r"[\"'](?:zod|zod/[^\"']*|@effect/schema[^\"']*)[\"']",
        register_diagnostic(span=$src, message="Use Schema from effect at project-owned boundaries.")
      },
      and {
        $src <: r"[\"'](?:@[^/\"']+/api(?:/[^\"']*)?|[^\"']*apps/api/[^\"']*|(?:\.\./)+api/[^\"']*)[\"']",
        $filename <: r".*/(?:apps/web|packages/contract)/src/.*",
        register_diagnostic(span=$src, message="Only apps/api imports the API; the site and the contract depend on the contract only.")
      },
      and {
        $src <: not r"[\"'](?:effect|effect/[^\"']*|\.[^\"']*)[\"']",
        $filename <: r".*/packages/contract/src/.*",
        register_diagnostic(span=$src, message="The contract imports only effect and its own files; it runs in Node and the browser.")
      }
    }
  },
  `console.$m($args)` as $c where {
    $filename <: r".*/(?:apps/api|packages/contract)/src/.*",
    register_diagnostic(span=$c, message="Log with Effect.log* and annotations, never console.")
  },
  `fetch($args)` as $f where {
    $filename <: r".*/apps/web/src/.*",
    $filename <: not r".*/apps/web/src/lib/.*",
    register_diagnostic(span=$f, message="Call the API through the client in apps/web/src/lib/api.ts, not a hand-written fetch.")
  },
  `process.env` as $e where {
    $filename <: r".*/(?:apps/(?:api|web)|packages/contract)/src/.*",
    $filename <: not r".*/apps/api/src/platform/.*",
    register_diagnostic(span=$e, message="Only apps/api/src/platform/ reads process.env; config.ts reads through Effect Config, and the site reads PUBLIC_ env through import.meta.env.")
  },
  or {
    `process.$x`,
    `process.$x = $v`,
    `globalThis.process`,
    `const $x = process`,
    `let $x = process`
  } as $p where {
    $p <: not `process.env`,
    $filename <: r".*/(?:apps/(?:api|web)|packages/contract)/src/.*",
    $filename <: not r".*/apps/api/src/platform/.*",
    register_diagnostic(span=$p, message="The process global belongs to apps/api/src/platform/.")
  },
  or {
    `Bun.$x`,
    `globalThis.Bun`
  } as $b where {
    $filename <: r".*/(?:apps/(?:api|web)|packages/contract)/src/.*",
    $filename <: not r".*/apps/api/src/platform/.*",
    register_diagnostic(span=$b, message="The Bun global belongs to apps/api/src/platform/.")
  }
}
