{
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test:unit)",
      "Bash(bun run test:unit *)",
      "Bash(bun run coverage)",
      "Bash(bunx vitest run)",
      "Bash(bunx vitest run *)",
      "Bash(bun run build)",
      "Bash(bun run check)",
      "Bash(bun run e2e)",
      "Bash(bun run e2e *)",
      "Bash(bun run dev)",
      "Bash(bun run dev *)",
      "Bash(./dist/*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/project-status.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cli-commands.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-boundaries.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
