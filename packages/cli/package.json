{
  "name": "quickstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "human": "bun scripts/human.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.registry.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:macos": "vitest run -t '\\(macOS\\)'",
    "coverage": "vitest run --coverage",
    "e2e": "bun run build && bun test ./e2e",
    "check": "bun run lint && bun run typecheck && bun run test && bun run e2e",
    "clean": "bun scripts/clean.ts",
    "ledger:import": "bun scripts/ledger-import.ts",
    "bench": "bun scripts/bench.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "smol-toml": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
